# --- Core application ---
MONGODB_URI=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Plant leaf disease analysis (AI) ---
# URL of the FastAPI PyTorch inference service (see ml/README.md).
PLANT_SERVICE_URL=http://127.0.0.1:8000
# Shared secret between the Next.js API and the inference service.
# Leave empty to disable token checking (service still binds to 127.0.0.1 only).
PLANT_SERVICE_TOKEN=
# Timeout for inference calls (milliseconds).
PLANT_SERVICE_TIMEOUT_MS=20000
# Maximum accepted image upload size (MB).
PLANT_MAX_UPLOAD_MB=8
# Optional LLM for grounded Q&A. Leave both empty to run in retrieval-only mode
# (answers are composed from GBIF/Wikipedia source text; no LLM is required).
PLANT_LLM_API_KEY=
PLANT_LLM_BASE_URL=
PLANT_LLM_MODEL=
