{
  "arch": "mobilenet_v3_small",
  "image_size": 224,
  "batch_size": 32,
  "epochs": 10,
  "learning_rate": 0.0008,
  "weight_decay": 0.0001,
  "label_smoothing": 0.1,
  "early_stopping_patience": 3,
  "freeze_backbone_epochs": 1,
  "num_workers": 4,
  "seed": 42,
  "use_class_weights": true,
  "scheduler": "cosine",
  "limit_per_class": 600,
  "smoke_test": false,
  "low_confidence_threshold": 0.45,
  "low_margin_threshold": 0.15
}
